{
  "name": "@feimacode/open-design-agent-kit-mcp",
  "version": "0.4.0-beta.3",
  "mcpName": "io.github.feimacode/open-design",
  "description": "Open Design as an MCP server: make posters, flyers, social posts, slide decks, landing pages and prototypes from any MCP-capable agent (Claude Code, Codex, Cursor, GitHub Copilot and others), with 198 design systems, browser checks and PDF, PNG or PowerPoint export.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "open-design",
    "design",
    "design-system",
    "design-systems",
    "poster",
    "flyer",
    "social-media",
    "instagram",
    "slides",
    "presentation",
    "pitch-deck",
    "landing-page",
    "prototype",
    "pdf",
    "print",
    "figma",
    "canva",
    "claude-code",
    "codex",
    "cursor",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feimacode/open-design-agent-kit.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/feimacode/open-design-agent-kit#readme",
  "bugs": {
    "url": "https://github.com/feimacode/open-design-agent-kit/issues"
  },
  "main": "out/index.js",
  "bin": {
    "open-design-mcp": "out/index.js"
  },
  "files": [
    "out"
  ],
  "scripts": {
    "compile": "tsx .esbuild.ts",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint src --ext ts",
    "test:unit": "mocha --require tsx/cjs 'src/test/unit/**/*.test.ts' --timeout 5000",
    "start": "node ./out/index.js"
  },
  "dependencies": {
    "@feimacode/open-design-agent-kit-content": "*",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@feimacode/open-design-agent-kit-core": "*"
  }
}
